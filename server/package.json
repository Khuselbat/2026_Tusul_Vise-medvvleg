{
  "name": "civiz-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Цахим виз мэдүүлгийн нэгдсэн веб программ — серверийн хэсэг",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset.js && node scripts/seed.js",
    "user:create-admin": "node scripts/create-admin.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"test/*.test.js\"",
    "maintenance:retention": "node scripts/retention.js",
    "keys:rotate": "node scripts/rotate-keys.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
